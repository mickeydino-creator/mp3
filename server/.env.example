PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Path to the yt-dlp binary. Must be installed on the host (pip install yt-dlp
# or download the release binary). Defaults to "yt-dlp" (resolved via PATH).
YTDLP_PATH=yt-dlp

# Path to the ffmpeg binary, required for audio extraction and format merging.
# Defaults to "ffmpeg" (resolved via PATH).
FFMPEG_PATH=ffmpeg

# Directory where converted files are temporarily stored before download and
# automatic cleanup. Defaults to ./storage relative to the server process.
STORAGE_DIR=./storage

# Optional: path to a Netscape-format cookies.txt file exported from a real,
# logged-in YouTube session. Cloud/datacenter hosts (Render included) are
# increasingly required to present an authenticated session to receive
# actual downloadable formats (metadata alone may still work without this).
# Export one with the "Get cookies.txt LOCALLY" browser extension while
# logged into the YouTube account you have rights to convert from, upload
# the file to your host, and point this at it. Treat it like a credential:
# do not commit it, and rotate it if it leaks.
# YTDLP_COOKIES_FILE=/app/secrets/youtube-cookies.txt

# Base URL of the bgutil-ytdlp-pot-provider HTTP server. It mints a real
# YouTube Proof-of-Origin token, which is what actually gets checked on
# flagged cloud IPs — no personal account needed. In the Docker image
# (server/Dockerfile + start.sh) this runs as a second process in the same
# container and is already set via ENV, so you normally don't need to touch
# this. For local (non-Docker) dev, clone and run the provider's server
# yourself (see https://github.com/Brainicism/bgutil-ytdlp-pot-provider)
# and point this at it — otherwise just leave it unset.
# POT_PROVIDER_URL=http://127.0.0.1:4416
